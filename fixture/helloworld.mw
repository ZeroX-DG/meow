let name: string = 'Hung';
let mut age: number = 22;


let hello = fn(name: string, age: number) {
    console.log('Hello my name is ' + name + '. I\'m ' + age + ' years old!');
};

let next_age = fn(age: number) -> number {
    return age + 1;
};

hello(name, age);

age = next_age(age);

hello(name, age);
